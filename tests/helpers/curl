#!/usr/bin/env bash
# Mock curl for testing - returns mocked responses from environment variables
#
# This script replaces curl during testing by being placed earlier in PATH.
# It returns controlled responses based on environment variables, enabling
# deterministic testing of HTTP request handling.
#
# Environment variables:
#   MOCK_CURL_RESPONSE      - JSON response body
#   MOCK_CURL_HTTP_CODE     - HTTP status code (default: 200)
#   MOCK_CURL_FAIL          - Set to 1 for connection failure (exit 7)
#   MOCK_CURL_EXIT_CODE     - Custom exit code, no output (default: 0)
#   MOCK_CURL_EXIT_AFTER_BODY - Exit with this code AFTER emitting body+trailer
#                             (simulates truncated transfer, e.g. 28)
#   MOCK_CURL_ARGS_FILE     - Path to record argv (one arg per line); resolved
#                             -H headers (incl. @file) go to <path>.headers
#
# When argv contains `-o <file>`, the body is written there (as real curl
# does) and nothing goes to stdout.
#   MOCK_CURL_CALL_COUNT    - Path to file for tracking call count
#   MOCK_CURL_RESPONSES     - Path to file with line-delimited responses (for retry testing)
#
# Example usage in BATS test:
#   export MOCK_CURL_RESPONSE='{"status":"ok"}'
#   export MOCK_CURL_HTTP_CODE=200
#   run ./yatti-api status
#   [[ "$status" -eq 0 ]]
#
# For retry testing with multiple sequential responses:
#   echo -e "500:{\"error\":\"fail\"}\n200:{\"status\":\"ok\"}" > "$BATS_TMPDIR/responses"
#   export MOCK_CURL_RESPONSES="$BATS_TMPDIR/responses"
#   export MOCK_CURL_CALL_COUNT="$BATS_TMPDIR/count"
#   # First call returns 500, second returns 200

# Record argv (and resolved -H headers, including @file forms) for tests
# that assert on what was actually sent
if [[ -n "${MOCK_CURL_ARGS_FILE:-}" ]]; then
  printf '%s\n' "$@" > "$MOCK_CURL_ARGS_FILE"
  : > "${MOCK_CURL_ARGS_FILE}.headers"
  prev=''
  for arg in "$@"; do
    if [[ "$prev" == '-H' ]]; then
      if [[ "$arg" == @* ]]; then
        # header-from-file: /dev/fd/N is valid here because the fd is inherited
        cat "${arg#@}" >> "${MOCK_CURL_ARGS_FILE}.headers" 2>/dev/null || true
      else
        printf '%s\n' "$arg" >> "${MOCK_CURL_ARGS_FILE}.headers"
      fi
    fi
    prev="$arg"
  done
fi

# Increment call counter if tracking file is set
if [[ -n "${MOCK_CURL_CALL_COUNT:-}" ]]; then
  declare -i count
  count=$(cat "$MOCK_CURL_CALL_COUNT" 2>/dev/null || echo 0)
  count+=1
  echo "$count" > "$MOCK_CURL_CALL_COUNT"

  # If we have a responses file, use line N for call N
  if [[ -n "${MOCK_CURL_RESPONSES:-}" ]] && [[ -f "${MOCK_CURL_RESPONSES:-}" ]]; then
    response=$(sed -n "${count}p" "$MOCK_CURL_RESPONSES")
    # Format: HTTP_CODE:RESPONSE or just RESPONSE (assumes 200)
    if [[ "$response" == *:* ]]; then
      http_code=${response%%:*}
      response=${response#*:}
    else
      http_code=200
    fi
  fi
fi

# Check if we should fail (connection error)
if [[ "${MOCK_CURL_FAIL:-0}" == "1" ]]; then
  echo "curl: (7) Failed to connect to test.yatti.local port 443: Connection refused" >&2
  exit 7
fi

# Check for custom exit code (e.g., timeout=28)
if [[ -n "${MOCK_CURL_EXIT_CODE:-}" ]] && [[ "$MOCK_CURL_EXIT_CODE" != "0" ]]; then
  exit "$MOCK_CURL_EXIT_CODE"
fi

# Read mock data from environment if not set by call counter logic
response="${response:-${MOCK_CURL_RESPONSE}}"
http_code="${http_code:-${MOCK_CURL_HTTP_CODE:-200}}"

# If no response set, use empty JSON object
if [[ -z "$response" ]]; then
  response="{}"
fi

# Honor -o <file>: real curl writes the body there, not to stdout
outfile=''
prev=''
for arg in "$@"; do
  [[ "$prev" == '-o' ]] && outfile=$arg
  prev=$arg
done

# Simulate a transfer that fails mid-body (e.g. timeout, exit 28): real curl
# still emits the partial body and the -w trailer with the received status code
if [[ -n "${MOCK_CURL_EXIT_AFTER_BODY:-}" ]] && [[ "$MOCK_CURL_EXIT_AFTER_BODY" != "0" ]]; then
  printf '%s\n__HTTP_CODE__%s' "$response" "$http_code"
  exit "$MOCK_CURL_EXIT_AFTER_BODY"
fi

# Output in the format curl -w "\n__HTTP_CODE__%{http_code}" would produce
# The response body, then newline, then __HTTP_CODE__, then the code (no trailing newline)
if [[ -n "$outfile" ]]; then
  printf '%s' "$response" > "$outfile"
else
  printf '%s\n__HTTP_CODE__%s' "$response" "$http_code"
fi
