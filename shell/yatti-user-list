#!/usr/bin/env bash
# yatti-user-list — List YaTTi Shell users with status
set -euo pipefail
shopt -s inherit_errexit
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin

declare -r PROG=${0##*/}
declare -r GROUP_NAME=yatti-shell

# Message helpers
_msg() { >&2 printf '%s: %s\n' "$PROG" "$1"; }
info()    { _msg "$1"; }
success() { _msg "OK: $1"; }
die()     { _msg "ERROR: $2"; exit "$1"; }

# Check group exists
if ! getent group "$GROUP_NAME" >/dev/null 2>&1; then
  echo "No ${GROUP_NAME} group found — run yatti-shell-setup first" >&2
  exit 1
fi

# Get group members. `getent group` lists only SUPPLEMENTARY members;
# yatti-user-add creates users with the group as PRIMARY (required by the
# nftables skgid match), so enumerate passwd for the GID as well.
declare -i GROUP_GID
GROUP_GID=$(getent group "$GROUP_NAME" | cut -d: -f3)

declare -A SEEN=()
declare -a USERS=()
declare -- member
while IFS= read -r member; do
  [[ -n "$member" && ! -v SEEN["$member"] ]] || continue
  SEEN["$member"]=1
  USERS+=("$member")
done < <(
  getent passwd | awk -F: -v gid="$GROUP_GID" '$4 == gid {print $1}'
  getent group "$GROUP_NAME" | cut -d: -f4 | tr ',' '\n'
)

if (( ${#USERS[@]} == 0 )); then
  echo "No YaTTi Shell users configured."
  exit 0
fi

printf '%-16s  %6s  %-20s  %s\n' "USERNAME" "CONVOS" "LAST LOGIN" "STATUS"
printf '%-16s  %6s  %-20s  %s\n' "--------" "------" "----------" "------"
declare -- user user_home last_login login_info status
declare -i conv_count
for user in "${USERS[@]}"; do
  # Count conversations
  conv_count=0
  user_home=$(getent passwd "$user" | cut -d: -f6) || continue
  if [[ -d "${user_home}/conversations" ]]; then
    conv_count=$(find "${user_home}/conversations" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
  fi

  # Last login
  last_login='-'
  login_info=$(lastlog -u "$user" 2>/dev/null | tail -1) || true
  if [[ "$login_info" != *"Never logged in"* ]] && [[ -n "$login_info" ]]; then
    last_login=$(echo "$login_info" | awk '{print $4, $5, $6, $7, $9}') || last_login='-'
  fi

  # Online status
  status='offline'
  if who | grep -q "^${user} "; then
    status="online"
  fi

  printf '%-16s  %6d  %-20s  %s\n' "$user" "$conv_count" "$last_login" "$status"
done

#fin
