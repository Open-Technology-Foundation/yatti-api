#!/usr/bin/env bash
# yatti-user-add — Create a YaTTi Shell user with SSH key and API key
set -euo pipefail
shopt -s inherit_errexit
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin

declare -r SCRIPT_NAME=${0##*/}
declare -r VERSION='1.0.0'
declare -r GROUP_NAME=yatti-shell
declare -r LAUNCHER=/usr/local/bin/yatti-shell-gate

# Message helpers
_msg() { >&2 printf '%s: %s\n' "$SCRIPT_NAME" "$1"; }
success() { _msg "OK: $1"; }
die()     { _msg "ERROR: $2"; exit "$1"; }

usage() {
  local -i rc=${1:-2}
  ((rc == 0)) || exec >&2
  cat <<USAGE
Usage: $SCRIPT_NAME [-k key-file] <username> <ssh-public-key>

Arguments:
  username        System username to create
  ssh-public-key  SSH public key string (ssh-ed25519 AAAA... user@host)

Options:
  -k, --key-file FILE  Read the YaTTi API key from FILE ('-' for stdin).
                       Without this option the key is prompted for
                       interactively. The key is never accepted as a
                       command-line argument (visible in ps and shell
                       history).
  -V, --version        Print version and exit

The user will be created with:
  - Login shell: $LAUNCHER
  - Primary group: $GROUP_NAME (required — the nftables egress rules
    match the primary GID only)
  - Home directory: /home/<username>
  - Default conversation: ~/conversations/general/

Workflow:
  1. Create the API user via the YaTTi web admin panel
  2. Run: $SCRIPT_NAME <username> '<ssh-key>' and paste the key at the prompt
USAGE
  exit "$rc"
}

# Argument parsing

(( EUID == 0 )) || die 1 'Must run as root'

declare -- KEY_FILE=''
declare -a POSITIONAL=()
while (($#)); do
  case $1 in
    -k|--key-file) [[ -n "${2:-}" ]] || die 2 "Option $1 requires an argument"
                   KEY_FILE=$2; shift ;;
    -h|--help)     usage 0 ;;
    -V|--version)  echo "$SCRIPT_NAME $VERSION"; exit 0 ;;
    -*)            die 2 "Unknown option ${1@Q}" ;;
    *)             POSITIONAL+=("$1") ;;
  esac
  shift
done
(( ${#POSITIONAL[@]} == 2 )) || usage

declare -r USERNAME=${POSITIONAL[0]}
declare -r SSH_KEY=${POSITIONAL[1]}
declare -- API_KEY=''

# Validate username
if [[ ! "$USERNAME" =~ ^[a-z][a-z0-9_-]{1,30}$ ]]; then
  die 2 'Invalid username: must be lowercase, start with letter, 2-31 chars'
fi

# Validate SSH key format
if [[ ! "$SSH_KEY" =~ ^ssh-(ed25519|rsa|ecdsa) ]]; then
  die 2 'Invalid SSH key format: must start with ssh-ed25519, ssh-rsa, or ssh-ecdsa'
fi

# Check prerequisites
[[ -x "$LAUNCHER" ]] || die 3 "Launcher not installed at $LAUNCHER — run 'make install' first"
getent group "$GROUP_NAME" &>/dev/null || die 3 "Group $GROUP_NAME missing — run yatti-shell-setup first"

# Load API key: file, stdin, or interactive prompt — never from argv
if [[ "$KEY_FILE" == '-' ]]; then
  API_KEY=$(cat)
elif [[ -n "$KEY_FILE" ]]; then
  [[ -r "$KEY_FILE" ]] || die 2 "Cannot read key file ${KEY_FILE@Q}"
  API_KEY=$(< "$KEY_FILE")
else
  read -rsp "$SCRIPT_NAME: Enter API key for $USERNAME: " API_KEY
  echo >&2
fi
API_KEY=${API_KEY//[$'\r\n']/}
[[ -n "$API_KEY" ]] || die 2 'API key cannot be empty'

# Create user

if id "$USERNAME" &>/dev/null; then
  die 4 "User ${USERNAME@Q} already exists"
fi

# Roll back a partially-created account on any later failure, so a re-run
# never finds a half-configured user; re-raises the original exit status
declare -i USER_CREATED=0
cleanup_on_fail() {
  local -i rc=$?
  trap - EXIT
  ((rc)) || exit 0
  if ((USER_CREATED)); then
    _msg "Rolling back partially-created user ${USERNAME@Q}"
    deluser --remove-home "$USERNAME" 2>/dev/null \
      || userdel -r "$USERNAME" 2>/dev/null \
      || _msg "WARNING: rollback failed — remove ${USERNAME@Q} manually"
  fi
  exit "$rc"
}
trap cleanup_on_fail EXIT

# Primary group MUST be ${GROUP_NAME}: the nftables egress rules match
# `meta skgid`, which sees only the primary GID — a supplementary
# membership would leave the firewall a silent no-op
adduser --disabled-password --gecos 'YaTTi Shell User' \
        --shell "$LAUNCHER" --ingroup "$GROUP_NAME" "$USERNAME" \
  || die 4 "Failed to create user ${USERNAME@Q}"
USER_CREATED=1
success "Created user $USERNAME with primary group $GROUP_NAME"

# SSH key

declare -r SSH_DIR="/home/$USERNAME/.ssh"
install -d -m 700 -o "$USERNAME" -g "$GROUP_NAME" "$SSH_DIR"
echo "$SSH_KEY" > "$SSH_DIR/authorized_keys"
chmod 600 "$SSH_DIR/authorized_keys"
chown "$USERNAME:$GROUP_NAME" "$SSH_DIR/authorized_keys"
success 'Installed SSH key'

# API key

declare -r CONFIG_DIR="/home/$USERNAME/.config/yatti-api"
install -d -m 700 -o "$USERNAME" -g "$GROUP_NAME" "/home/$USERNAME/.config"
install -d -m 700 -o "$USERNAME" -g "$GROUP_NAME" "$CONFIG_DIR"
install -m 600 /dev/null "$CONFIG_DIR/api_key"
echo "$API_KEY" > "$CONFIG_DIR/api_key"
chown "$USERNAME:$GROUP_NAME" "$CONFIG_DIR/api_key"
success 'Saved API key'

# Conversation directory

declare -r CONV_DIR="/home/$USERNAME/conversations"
install -d -m 755 -o "$USERNAME" -g "$GROUP_NAME" "$CONV_DIR"
install -d -m 755 -o "$USERNAME" -g "$GROUP_NAME" "$CONV_DIR/general"
ln -sf general "$CONV_DIR/.current"
chown -h "$USERNAME:$GROUP_NAME" "$CONV_DIR/.current"
success 'Created default conversation directory'

# All steps succeeded — disarm the rollback
trap - EXIT

# Summary

cat >&2 <<SUMMARY

User $USERNAME created successfully.
  Home:    /home/$USERNAME
  Shell:   $LAUNCHER
  Group:   $GROUP_NAME
  SSH in:  ssh $USERNAME@$(hostname)

SUMMARY

#fin
