#!/usr/bin/env bash
# yatti-shell-setup — One-time system setup for YaTTi Shell environment
# Creates group, shared config, busybox symlinks, and nftables rules
set -euo pipefail
shopt -s inherit_errexit
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin

# Constants
declare -r SCRIPT_NAME=${0##*/}
# shellcheck disable=SC2155  # combined declare/assign intentional (project convention)
declare -r SCRIPT_DIR=$(dirname -- "$(realpath -- "$0")")
declare -r SHARE_DIR=/usr/local/share/yatti-shell
declare -r BIN_DIR="$SHARE_DIR/bin"
declare -r CONF_DIR="$SHARE_DIR/conf"
declare -r GROUP_NAME=yatti-shell

# Allowed busybox applets for the sandbox
declare -ra ALLOWED_APPLETS=(
  ls cat grep head tail wc less mkdir rm rmdir pwd
  cp mv date echo printf sort uniq tee tr vi sed awk
  find xargs dirname basename touch chmod stat df du
  clear reset true false test seq id whoami sleep
  ln readlink realpath sha256sum md5sum
)

# Busybox applets replaced with coreutils versions for full flag compatibility
declare -ra COREUTILS_CMDS=(
  cat ls head tail grep sort wc mkdir rm rmdir
  cp mv chmod stat touch find xargs date less realpath dircolors sed
  bc top free
)

# Message helpers
_msg() { >&2 printf '%s: %s\n' "$SCRIPT_NAME" "$1"; }
info()    { _msg "$1"; }
success() { _msg "OK: $1"; }
warn()    { _msg "WARNING: $1"; }
die()     { _msg "ERROR: $2"; exit "$1"; }

main() {
  local -- cmd applet editor file

  # Root check
  (( EUID == 0 )) || die 1 'Must run as root'

  # Prerequisites
  info 'Checking prerequisites...'

  local -a missing=()
  for cmd in bwrap busybox curl jq yatti-api nft dig; do
    command -v "$cmd" >/dev/null || missing+=("$cmd")
  done

  if (( ${#missing[@]} > 0 )); then
    die 18 "Missing commands: ${missing[*]}"
  fi

  success 'All prerequisites found'

  # bwrap setuid
  local -- bwrap_bin
  bwrap_bin=$(command -v bwrap)
  if [[ ! -u "$bwrap_bin" ]]; then
    chmod u+s "$bwrap_bin" || die 5 "Failed to set setuid on ${bwrap_bin@Q}"
    success "Set setuid on $bwrap_bin (required for user namespace creation)"
  else
    info 'bwrap already setuid'
  fi

  # System group
  if getent group "$GROUP_NAME" &>/dev/null; then
    info "Group $GROUP_NAME already exists"
  else
    groupadd --system "$GROUP_NAME" || die 1 "Failed to create group ${GROUP_NAME@Q}"
    success "Created system group $GROUP_NAME"
  fi

  # Shared directories
  install -d -m 755 "$SHARE_DIR" "$BIN_DIR" "$CONF_DIR" \
    || die 5 "Failed to create shared directories under ${SHARE_DIR@Q}"

  # Busybox applet symlinks
  info "Creating busybox applet symlinks in $BIN_DIR..."

  # Get list of available applets
  local -A available_applets=()
  while IFS= read -r applet; do
    available_applets["$applet"]=1
  done < <(busybox --list)

  local -i created=0
  local -i skipped=0

  for applet in "${ALLOWED_APPLETS[@]}"; do
    if [[ -v available_applets["$applet"] ]]; then
      # Target /usr/bin/busybox — the path inside the bwrap sandbox
      ln -sf /usr/bin/busybox "$BIN_DIR/$applet" \
        || die 5 "Failed to create applet symlink ${applet@Q}"
      created+=1
    else
      warn "Applet ${applet@Q} not available in busybox"
      skipped+=1
    fi
  done

  success "Created $created symlinks ($skipped skipped)"

  # Add busybox binary and env to BIN_DIR so it's a self-contained /usr/bin
  install -m 755 /usr/bin/busybox "$BIN_DIR/busybox" \
    || die 5 "Failed to install busybox into ${BIN_DIR@Q}"
  install -m 755 /usr/bin/env "$BIN_DIR/env" \
    || die 5 "Failed to install env into ${BIN_DIR@Q}"
  success "Copied busybox and env binaries to $BIN_DIR"

  # Replace key busybox applets with coreutils versions for full flag compatibility
  for cmd in "${COREUTILS_CMDS[@]}"; do
    if [[ -x "/usr/bin/$cmd" ]]; then
      install -m 755 "/usr/bin/$cmd" "$BIN_DIR/$cmd" \
        || die 5 "Failed to install coreutils ${cmd@Q} into ${BIN_DIR@Q}"
    fi
  done
  success "Installed coreutils overrides for ${#COREUTILS_CMDS[@]} commands"

  # Add editors if available
  for editor in joe nano; do
    if command -v "$editor" >/dev/null; then
      install -m 755 "$(command -v "$editor")" "$BIN_DIR/$editor" \
        || die 5 "Failed to install editor ${editor@Q} into ${BIN_DIR@Q}"
      success "Copied $editor to $BIN_DIR"
    fi
  done

  # Copy static config files
  for file in bashrc motd; do
    if [[ -f "$SCRIPT_DIR/$file" ]]; then
      install -m 644 "$SCRIPT_DIR/$file" "$CONF_DIR/$file" \
        || die 5 "Failed to install ${file@Q} into ${CONF_DIR@Q}"
      success "Installed $file to $CONF_DIR/"
    else
      warn "$file not found in $SCRIPT_DIR/ — install manually later"
    fi
  done

  # Install bash completion if available
  local -r COMPLETION_SRC="$SCRIPT_DIR/../yatti-api.bash_completion"
  if [[ -f "$COMPLETION_SRC" ]]; then
    install -m 644 "$COMPLETION_SRC" "$CONF_DIR/yatti-api.bash_completion" \
      || die 5 'Failed to install bash completion'
    success 'Installed bash completion'
  fi

  # nftables rules
  info 'Configuring nftables rules...'

  # Resolve yatti.id IP (may change — admin should re-run setup if DNS changes)
  local -- yatti_ip
  yatti_ip=$(dig +short yatti.id A 2>/dev/null | head -1) || true

  if [[ -z "$yatti_ip" ]]; then
    warn 'Could not resolve yatti.id — skipping nftables setup'
    warn 'Run this script again when DNS is available, or add rules manually'
  else
    local -r NFT_CONF=/etc/nftables.d/yatti-shell.conf

    install -d -m 755 /etc/nftables.d || die 5 'Failed to create /etc/nftables.d'

    # NOTE: `meta skgid` matches the socket owner's PRIMARY (effective) GID only,
    # never supplementary groups. yatti-user-add therefore creates users with
    # ${GROUP_NAME} as their primary group; a supplementary membership would make
    # every rule below a silent no-op.
    cat > "$NFT_CONF" <<NFTEOF || die 5 "Failed to write ${NFT_CONF@Q}"
#!/usr/sbin/nft -f
# YaTTi Shell — restrict yatti-shell group to yatti.id:443 only
# Resolved IP: $yatti_ip (re-run yatti-shell-setup if DNS changes)
# skgid matches PRIMARY group only — sandbox users must have $GROUP_NAME
# as their primary group (yatti-user-add does this).

table inet yatti-shell {
  chain output {
    type filter hook output priority 0; policy accept;

    # Allow localhost (DNS stub resolver)
    meta skgid $GROUP_NAME oifname "lo" accept

    # Allow yatti.id on HTTPS
    meta skgid $GROUP_NAME ip daddr $yatti_ip tcp dport 443 accept

    # Drop everything else from yatti-shell group
    meta skgid $GROUP_NAME drop
  }
}
NFTEOF

    # Validate before loading
    if ! nft -c -f "$NFT_CONF"; then
      die 19 "Generated nftables rules failed validation: $NFT_CONF"
    fi

    # Load the rules
    if nft -f "$NFT_CONF" 2>/dev/null; then
      success "nftables rules loaded (yatti.id=$yatti_ip)"
    else
      warn "Failed to load nftables rules — load manually: nft -f $NFT_CONF"
    fi

    # Persist across reboots: main config must include /etc/nftables.d and the
    # nftables service must be enabled, or the rules exist only until shutdown
    if [[ -f /etc/nftables.conf ]]; then
      if ! grep -qE '^[[:space:]]*include[[:space:]]+"/etc/nftables\.d/\*\.conf"' /etc/nftables.conf; then
        cp -a /etc/nftables.conf "/etc/nftables.conf.bak-yatti-$(printf '%(%Y%m%d)T' -1)" \
          || die 5 'Failed to back up /etc/nftables.conf — not modifying it'
        printf '\ninclude "/etc/nftables.d/*.conf"\n' >> /etc/nftables.conf \
          || die 5 'Failed to append include to /etc/nftables.conf'
        success 'Added include "/etc/nftables.d/*.conf" to /etc/nftables.conf (backup saved)'
      else
        info 'nftables.d include already present in /etc/nftables.conf'
      fi
    else
      warn 'No /etc/nftables.conf — add include "/etc/nftables.d/*.conf" to boot config manually'
    fi
    if ! systemctl is-enabled nftables &>/dev/null; then
      if systemctl enable nftables &>/dev/null; then
        success 'Enabled nftables service (rules now persist across reboots)'
      else
        warn 'Could not enable nftables service — rules will NOT survive a reboot'
      fi
    fi
  fi

  # Summary
  cat >&2 <<SUMMARY

Setup complete. Next steps:
  1. Install launcher:  sudo install -m 755 $SCRIPT_DIR/yatti-shell-launcher /usr/local/bin/
  2. Add SSH config:    sudo install -m 644 $SCRIPT_DIR/50-yatti-shell.conf /etc/ssh/sshd_config.d/
  3. Reload SSH:        sudo systemctl reload sshd
  4. Add a user:        sudo $SCRIPT_DIR/yatti-user-add <username> '<ssh-pubkey>'  (API key prompted)

SUMMARY
}

main "$@"

#fin
