#!/usr/bin/env bash
# yatti-shell-launcher — Login shell for YaTTi Shell users
# Constructs a bwrap namespace sandbox and drops into bash with YaTTi env
set -euo pipefail
shopt -s inherit_errexit
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin

declare -r SCRIPT_NAME=${0##*/}
declare -r SHARE_DIR=/usr/local/share/yatti-shell
declare -r BIN_DIR="$SHARE_DIR/bin"
declare -r CONF_DIR="$SHARE_DIR/conf"

# Message helpers
_msg() { >&2 printf '%s: %s\n' "$SCRIPT_NAME" "$1"; }
die()  { _msg "ERROR: $2"; exit "$1"; }

# Validate environment
[[ -d "$BIN_DIR" ]]  || die 19 "Missing $BIN_DIR — run yatti-shell-setup first"
[[ -d "$CONF_DIR" ]] || die 19 "Missing $CONF_DIR — run yatti-shell-setup first"
command -v bwrap >/dev/null || die 18 'bubblewrap (bwrap) not found'

# Load API key
declare -- API_KEY=''
declare -r KEY_FILE="$HOME/.config/yatti-api/api_key"

if [[ -f "$KEY_FILE" ]]; then
  API_KEY=$(< "$KEY_FILE")
elif [[ -n "${YATTI_API_KEY:-}" ]]; then
  API_KEY=$YATTI_API_KEY
fi

if [[ -z "$API_KEY" ]]; then
  die 19 'No API key found — contact administrator'
fi

# Ensure conversation directory
declare -r CONV_DIR="$HOME/conversations"
mkdir -p "$CONV_DIR/general" || die 5 "Cannot create conversation directory ${CONV_DIR@Q}"
# Set default conversation if not set
if [[ ! -L "$CONV_DIR/.current" ]]; then
  ln -sf general "$CONV_DIR/.current" || die 5 'Cannot set default conversation symlink'
fi

# Minimal passwd/group for UID resolution
declare -r ETC_STAGING="$HOME/.cache/yatti-shell-etc"
mkdir -p "$ETC_STAGING" || die 5 "Cannot create staging directory ${ETC_STAGING@Q}"
declare -- REAL_USER
REAL_USER=$(id -un)
declare -i REAL_UID REAL_GID
REAL_UID=$(id -u)
REAL_GID=$(id -g)
echo 'root:x:0:0:root:/root:/bin/bash' > "$ETC_STAGING/passwd"
echo "$REAL_USER:x:$REAL_UID:$REAL_GID:YaTTi User:/home/user:/bin/bash" >> "$ETC_STAGING/passwd"
echo 'root:x:0:' > "$ETC_STAGING/group"
echo "$REAL_USER:x:$REAL_GID:" >> "$ETC_STAGING/group"

# Resource limits
ulimit -u 200       # max processes
ulimit -f 102400    # max file size (100 MB in 1K blocks)
ulimit -n 64        # max open files
ulimit -t 3600      # max CPU time (1 hour)

# Resolve paths
declare -- BASH_BIN CURL_BIN JQ_BIN YATTI_BIN
BASH_BIN=$(command -v bash)   || die 18 'bash not found'
CURL_BIN=$(command -v curl)   || die 18 'curl not found'
JQ_BIN=$(command -v jq)       || die 18 'jq not found'
YATTI_BIN=$(command -v yatti-api) || YATTI_BIN=/usr/local/bin/yatti-api
[[ -x "$YATTI_BIN" ]] || die 18 'yatti-api not found'

# Resolve DNS config
declare -- RESOLV_CONF=/etc/resolv.conf
if [[ -L "$RESOLV_CONF" ]]; then
  # Follow symlink (Ubuntu uses stub-resolv.conf via systemd-resolved)
  RESOLV_CONF=$(realpath "$RESOLV_CONF")
fi

# Build bwrap command
declare -a BWRAP_ARGS=(
  # /usr/bin — busybox applet symlinks, busybox binary, and env
  # Self-contained: BIN_DIR has everything yatti-api's PATH needs
  --ro-bind "$BIN_DIR" /usr/bin

  # /usr/local/bin — core binaries
  --ro-bind "$BASH_BIN"   /usr/local/bin/bash
  --ro-bind "$CURL_BIN"   /usr/local/bin/curl
  --ro-bind "$JQ_BIN"     /usr/local/bin/jq
  --ro-bind "$YATTI_BIN"  /usr/local/bin/yatti-api

  # Editor config/syntax files (binaries are in BIN_DIR → /usr/bin)
  --ro-bind /etc/joe        /etc/joe
  --ro-bind /usr/share/joe  /usr/share/joe
  --ro-bind /usr/share/nano /usr/share/nano

  # Bash completion library
  --ro-bind /usr/share/bash-completion /usr/share/bash-completion

  # /bin — symlinks for #!/bin/bash shebangs
  --symlink /usr/local/bin/bash /bin/bash

  # Shared libraries (required by bash, curl, jq)
  --ro-bind /lib/x86_64-linux-gnu /lib/x86_64-linux-gnu
  --ro-bind /lib64               /lib64

  # TLS certificates (required by curl)
  --ro-bind /etc/ssl /etc/ssl

  # Minimal passwd/group for UID→name resolution
  --ro-bind "$ETC_STAGING/passwd" /etc/passwd
  --ro-bind "$ETC_STAGING/group"  /etc/group

  # DNS resolver
  --ro-bind "$RESOLV_CONF" /etc/resolv.conf

  # Shell configuration
  --ro-bind "$CONF_DIR" /etc/yatti-shell

  # User home (writable)
  --bind "$HOME" /home/user

  # Pseudo-filesystems
  --dev  /dev
  --proc /proc
  --tmpfs /tmp

  # Namespace isolation
  --unshare-pid
  --die-with-parent

  # Environment: start from empty — the login environment (SSH_*, XDG_*,
  # LS_COLORS, any host secrets) must not leak into the sandbox; everything
  # the shell needs is set explicitly below
  --clearenv

  # Working directory and environment
  --chdir /home/user
  --setenv HOME        /home/user
  --setenv PATH        /usr/local/bin:/usr/bin:/bin
  --setenv TERM        "${TERM:-xterm}"
  --setenv LANG         C
  --setenv LC_ALL       C
  --setenv YATTI_API_KEY "$API_KEY"
  --setenv YATTI_SHELL  1
  --setenv USER         "$REAL_USER"
)

# Enter sandbox

# Scrub loader-influencing variables from bwrap's OWN environment
# (--clearenv only sanitises the sandboxed child, not the bwrap process;
# SHELLOPTS is readonly in bash and cannot be unset)
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV

exec bwrap "${BWRAP_ARGS[@]}" \
  /bin/bash --rcfile /etc/yatti-shell/bashrc -i

#fin
