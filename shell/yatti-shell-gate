#!/usr/bin/env bash
# yatti-shell-gate — Routes SSH sessions to shell or SFTP
# Interactive sessions → bwrap sandbox shell
# SFTP sessions → sftp-server (read-only, for data export)
# Everything else → rejected
set -euo pipefail
shopt -s inherit_errexit
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin

declare -r SCRIPT_NAME=${0##*/}

# Scrub loader-influencing variables before any exec — this is an SSH
# ForceCommand gatekeeper and must not honour session-supplied loader hooks
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV \
      PYTHONPATH PERL5LIB RUBYLIB NODE_PATH

case ${SSH_ORIGINAL_COMMAND:-} in
  '')
    # Interactive session → YaTTi shell
    exec /usr/local/bin/yatti-shell-launcher
    ;;
  */sftp-server*|internal-sftp*)
    # SFTP → read-only sftp-server
    exec /usr/lib/openssh/sftp-server -R
    ;;
  *)
    # Legacy scp (scp -O) would exec an unsandboxed, read-write scp on the
    # host — rejected. Modern scp speaks SFTP and is served read-only by the
    # sftp-server branch above.
    >&2 printf '%s: Only interactive shell and read-only SFTP export are allowed (use sftp or modern scp).\n' \
      "$SCRIPT_NAME"
    exit 1
    ;;
esac

#fin
