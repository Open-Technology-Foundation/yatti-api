HISTFILESIZE=10000

# ── Knowledgebase Cache ───────────────────────────────────────────────────────

# Fetch KB names once at login — unlikely to change during session
declare -a YATTI_KB_LIST=()
_yatti_load_kbs() {
  local -- json
  json=$(curl -s --connect-timeout 5 --max-time 15 \
    -H "X-API-Key: ${YATTI_API_KEY:-}" \
    "${YATTI_API_BASE:-https://yatti.id/v1}/knowledgebases" 2>/dev/null) || return 1
  local -- names
  names=$(echo "$json" | jq -r '.data.knowledgebases[]?.name // empty' 2>/dev/null) || return 1
  [[ -n "$names" ]] || return 1
  while IFS= read -r name; do
    [[ -n "$name" ]] && YATTI_KB_LIST+=("$name")
  done <<< "$names"
}
_yatti_load_kbs || true
# Reload command if login fetch failed
kbrefresh() {
  YATTI_KB_LIST=()
  if _yatti_load_kbs; then
    echo "Loaded ${#YATTI_KB_LIST[@]} knowledgebases: ${YATTI_KB_LIST[*]}"
  else
    echo "Failed to fetch knowledgebase list" >&2
  fi
}

# ── Conversation State ────────────────────────────────────────────────────────

declare -r CONV_BASE="${HOME}/conversations"
declare -- CONV_NAME
declare -- CONV_DIR
declare -- YATTI_KB=''

_conv_resolve() {
  if [[ -L "${CONV_BASE}/.current" ]]; then
    local -- resolved
    resolved=$(cd -P "${CONV_BASE}/.current" 2>/dev/null && pwd) || true
    CONV_NAME=${resolved##*/}
    CONV_NAME=${CONV_NAME:-general}
    CONV_DIR="${CONV_BASE}/${CONV_NAME}"
  else
    CONV_NAME=general
    CONV_DIR="${CONV_BASE}/general"
  fi
  # Load per-conversation default KB
  if [[ -f "${CONV_DIR}/.kb" ]]; then
    YATTI_KB=$(cat "${CONV_DIR}/.kb")
  else
    YATTI_KB=''
  fi
}
_conv_resolve

# ── Prompt ────────────────────────────────────────────────────────────────────

declare -x PS1
declare -i PROMPT_DIRTRIM=3

_yatti_prompt() {
  local -i rc=$?
  _conv_resolve
  local -- kb_tag=''
  [[ -n "$YATTI_KB" ]] && kb_tag="[${YATTI_KB}]"
  PS1="\[\e]0;${CONV_NAME}${kb_tag}@yatti: \w\a\]"        # Terminal title
  PS1+="\[\033[38;5;8m\]${rc}:"                             # Exit code (gray)
  PS1+="\[\033[00m\]\[\033[01;34m\]\w"                      # Path (blue)
  PS1+="\[\033[00m\]:\[\033[01;32m\]${CONV_NAME}"          # Conversation (green)
  [[ -n "$YATTI_KB" ]] && PS1+="\[\033[01;33m\][$YATTI_KB]" # KB tag (yellow)
  PS1+="\[\033[01;32m\]@yatti"                              # @yatti (green)
  PS1+="\[\033[00m\]\n\$ "                                  # Newline + prompt
}
PROMPT_COMMAND=_yatti_prompt

